do_build() {
	./build.sh --minify=all --compress=true
}

do_install() {
	for _bin in bin/*; do
		vbin $_bin
	done
	for _man in man/*; do
		vman $_man
	done
	vlicense LICENSE.md
}

batgrep_package() {
	depends="bat ripgrep"
	short_desc="Quickly search through and highlight files using ripgrep"
	pkg_install() {
		vbin bin/batgrep
		vman man/batgrep.1
		vlicense LICENSE.md
	}
}

