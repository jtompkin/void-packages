depends="bat"
depends="bat entr fzf ripgrep"
short_desc="Bash scripts that integrate bat with various command line tools"
maintainer="jtompkin <jtompkin-dev@pm.me>"
license=MIT
homepage="https://github.com/eth-p/bat-extras"
distfiles="https://github.com/eth-p/bat-extras/archive/${_commit}.tar.gz"
