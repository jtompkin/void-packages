# Options for the kernel hook script installed by the efibootmgr package.
MODIFY_EFI_UKI_ENTRIES=0
# To allow efibootmgr to modify boot entries, set
# MODIFY_EFI_UKI_ENTRIES=1
# Disk where EFI Partition is.  Default is /dev/sda
# DISK="/dev/sda"
# Partition number of EFI Partition.  Default is 1
# PART=1
# Path to directory containing UKIs starting from ESP (using Windows path separators).
# Must include terminal path separator.
# Default is \EFI\void\
# UKI_DIR='\EFI\void\'
